# Copy to .env and adjust. All variables are validated at startup.

NODE_ENV=development
PORT=3000

# With docker compose the hostname is "mongo".
MONGO_URI=mongodb://localhost:27017/nest-task-api

# Comma-separated origins, or *.
CORS_ORIGIN=*

# Generate secrets with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=change-me-access-secret-at-least-32-chars-long
JWT_ACCESS_TTL=15m
JWT_REFRESH_SECRET=change-me-refresh-secret-at-least-32-chars-long
JWT_REFRESH_TTL=7d

# Max THROTTLE_LIMIT requests per THROTTLE_TTL_MS per client.
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=100
